# Local development only. Copy to .dev.vars and never commit real secrets.
TELEGRAM_BOT_TOKEN=replace-me
RELAY_TOKEN=replace-me
TELEGRAM_CHAT_ID=-1001234567890

# Optional: server-side Instagram/X metadata fetch timeout (1000-12000 ms).
SOCIAL_METADATA_TIMEOUT_MS=5000

# Optional: privacy-safe, structured step-by-step Worker logs. Keep unset in production.
RELAY_DEBUG=false

# CPU-heavy parsing/remux/hashing is disabled by default.
ENABLE_CPU_HEAVY=false

# Optional: max binary thumbnail bytes encoded into Base64 responses (default 384 KiB).
THUMBNAIL_BASE64_MAX_BYTES=393216
