# Local development only. Copy to .dev.vars and never commit real secrets.
TELEGRAM_BOT_TOKEN=replace-me
RELAY_TOKEN=replace-me
TELEGRAM_CHAT_ID=-1001234567890

# Optional: server-side Instagram/X metadata fetch timeout (1000-12000 ms).
SOCIAL_METADATA_TIMEOUT_MS=5000

# Optional: privacy-safe, structured step-by-step Worker logs. Keep unset in production.
RELAY_DEBUG=false

# CPU-heavy parsing/remux/hashing is disabled by default.
ENABLE_CPU_HEAVY=false

# Optional: max binary thumbnail bytes encoded into Base64 responses (default 384 KiB).
THUMBNAIL_BASE64_MAX_BYTES=393216

# Instagram resolver chain (all keys are optional; NEVER commit real values).
# sssInstagram v2 story endpoint is undocumented. The HMAC signing scheme
# is inferred from legacy /api/convert, and may not work for the current v2.
# Enable only with a validated current key + matching browser bundle _ts.
# SSSINSTAGRAM_HMAC_KEY=replace-with-current-signing-key
# SSSINSTAGRAM_BUILD_TS=replace-with-current-bundle-timestamp
#
# Optional paid, documented API fallbacks, used only after free/self-hosted ones.
# EASYDOWN_API_KEY=replace-me
# GETINSAVER_API_KEY=replace-me


# Optional: default chat for POST /notifications/send (numeric ID, @channel, or ID:topic).
NOTIFICATION_CHAT_ID=-1001234567890

# Required to use POST /webhooks/github. Must match GitHub's Webhook Secret.
# Create a separate strong random secret via: npx wrangler secret put GITHUB_WEBHOOK_SECRET
# GITHUB_WEBHOOK_SECRET=replace-with-long-random-secret

# Destination for GitHub Actions status notifications (supports ID:topic).
GITHUB_WEBHOOK_CHAT_ID=-1001234567890

# Optional filter: completed (default), or requested,in_progress,completed
GITHUB_NOTIFY_ACTIONS=completed

# Required to use POST /notifications/send; separate from RELAY_TOKEN.
# NOTIFICATION_API_TOKEN=replace-with-long-random-secret
