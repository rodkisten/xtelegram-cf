{
  "name": "generic-telegram-media-relay",
  "version": "2.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler build",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lockfile:refresh": "npm install --package-lock-only --ignore-scripts",
    "db:create": "wrangler d1 create xtelegram-relay",
    "db:migrate:local": "wrangler d1 migrations apply xtelegram-relay --local",
    "db:migrate:remote": "wrangler d1 migrations apply xtelegram-relay --remote",
    "db:migrations:list": "wrangler d1 migrations list xtelegram-relay"
  },
  "dependencies": {
    "mux.js": "7.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  },
  "packageManager": "npm@10.9.2"
}
